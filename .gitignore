# Local environment files (keep documented templates)
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Google Cloud / Firebase service-account credentials
**/serviceAccountKey.json
**/service-account-key.json
**/*serviceAccountKey*.json
**/*service-account-key*.json
**/*-firebase-adminsdk-*.json
**/google-application-credentials.json

# Private keys and certificate bundles
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Common local credential files
**/credentials.json
**/secrets.json

# OS and editor metadata
**/.DS_Store
**/.idea/

# Dependencies, build output, and local caches
**/node_modules/
**/.firebase/
**/.dart_tool/
**/.cxx/
**/build/
**/coverage/
